-- A CLUSTER BY subquery as a join branch, and under a LIMIT: the join enumerator and its LIMIT-based
-- selectivity must treat the clause as they treat GROUP BY (the analyzed suite runs this with CBO on).
drop dataverse test if exists;
create dataverse test;
use test;
create type PointType as closed {
  id : integer,
  vec : [double]
};
create dataset Points(PointType) primary key id;
create type LabelType as closed { id : integer, label : string };
create dataset Labels(LabelType) primary key id;
