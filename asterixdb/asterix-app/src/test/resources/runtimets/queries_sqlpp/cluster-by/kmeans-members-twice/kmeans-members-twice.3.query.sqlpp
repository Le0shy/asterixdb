-- members read by two subqueries of one SELECT, over an unpartitioned input, ordered by one of them: the
-- generic EnforceOrderByAfterSubplan rule must stop at CLUSTER BY as it does at GROUP BY, or it copies the
-- input subquery's ORDER BY above the clause where its variable no longer exists.
use test;
from (select value q from Points as q order by q.id limit 100) as p cluster by p.vec as sc cluster as members
with { "dimension": [2], "num_clusters": 2 }
select array_count(members) as cnt,
       (select value gi.p.id + 1 from members as gi order by gi.p.id) as plus_one,
       (select value gi.p.id from members as gi order by gi.p.id) as ids
order by ids;
