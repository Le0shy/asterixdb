-- Four well-separated groups of very unequal size. Trivially separable -- the groups are rings of radius 1
-- centred ten apart -- so the exact partition is knowable in advance, which makes this a check on
-- initialization quality rather than on convergence.
--
-- It exists because an inertia sweep did not catch a seeding regression here. Total inertia over a large,
-- roughly uniform embedding cloud barely moves when one small group is missed, so a quality loss that is
-- obvious on structured data was invisible in the aggregate. This fixture is the structured case.
drop dataverse test if exists;
create dataverse test;
use test;

create type PointType as closed { id : integer, vec : [double] };
create dataset Points(PointType) primary key id;
