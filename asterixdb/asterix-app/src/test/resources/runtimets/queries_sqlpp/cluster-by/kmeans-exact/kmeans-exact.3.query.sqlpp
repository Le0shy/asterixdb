use test;
set `cluster_by_runtime_init` "true";
-- Exact Bernoulli oversampling (initMode "kmeansPP-exact"). LABEL-INVARIANT output: cluster_id labels are
-- arbitrary in k-means, so report the PARTITION -- each cluster as the sorted list of its member ids, with
-- clusters ordered canonically. The partition is deterministic (fixed per-round seed + fixed topology) and,
-- on this well-separated data, must be {1,2,5} and {3,4,6}.
select value c.ids
from (
  from Points as p
  cluster by p.vec as sc
  cluster as members
  with { "NumClusters": 2, "initMode": "kmeansPP-exact" }
  select (select value m.p.id from members as m order by m.p.id) as ids
) as c
order by c.ids;
