-- APE 33 Database Design #1 (movies and reviews as separate collections): joins are not supported in
-- v1, so CLUSTER BY over more than one FROM term must be rejected at compile time.
from [{"movie_id": 1, "movie_year": 2019}] as m,
     [{"movie_id": 1, "reviewEmbedding": [1.0, 2.0]}] as r
where r.movie_id = m.movie_id and m.movie_year < 2020
cluster by r.reviewEmbedding as sc
cluster as rvc
with { "NumClusters": 5 }
select sc.cluster_id as cid, array_count(rvc) as cnt, rvc;
