use test;
-- Distributed k-means (SQL++ desugar form): k=2, seed by id%2, 3 unrolled Lloyd iterations, then label.
-- LABEL-INVARIANT output: cluster_id values are arbitrary in k-means (which physical cluster gets label 0 vs 1
-- depends on seed-group ordering), so we report the PARTITION: each cluster as the sorted list of its member ids,
-- with clusters ordered canonically. The partition itself is deterministic (fixed seed + fixed iterations).
select value members
from Points r
let C0 = (select value centroid(s.vec) from Points s group by (s.id % 2)),
    C1 = (select value centroid(s.vec) from Points s group by nearest_centroid(s.vec, C0)),
    C2 = (select value centroid(s.vec) from Points s group by nearest_centroid(s.vec, C1)),
    C3 = (select value centroid(s.vec) from Points s group by nearest_centroid(s.vec, C2))
group by nearest_centroid(r.vec, C3) group as g
let members = (select value gi.r.id from g as gi order by gi.r.id)
order by members;
