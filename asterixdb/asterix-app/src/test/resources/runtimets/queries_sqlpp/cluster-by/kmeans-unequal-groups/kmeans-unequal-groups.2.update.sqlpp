-- 100 rows in groups of 40, 30, 20 and 10, at (0,0), (10,10), (20,20) and (30,30), each a unit ring.
use test;

insert into Points (
  select i as id,
         [ g * 10.0 + sin(i), g * 10.0 + cos(i) ] as vec
  from range(1, 100) as i
  let g = case when i <= 40 then 0
               when i <= 70 then 1
               when i <= 90 then 2
               else 3 end
);
