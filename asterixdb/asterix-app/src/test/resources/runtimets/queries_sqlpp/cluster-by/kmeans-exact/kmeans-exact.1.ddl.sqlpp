-- CLUSTER BY initMode "kmeansPP-exact": the paper-faithful (Bahmani et al. VLDB'12, Algorithm 2) Bernoulli
-- oversampling in the runtime operator tower. Tiny 2-D dataset with two well-separated clusters near the
-- origin and near (8,8); k=2. Requires runtime init (the exact path has no desugar reference form).
drop dataverse test if exists;
create dataverse test;
use test;
set `cluster_by_runtime_init` "true";
create type PointType as closed {
  id : integer,
  vec : [double]
};
create dataset Points(PointType) primary key id;
