<test-group name="cluster-by">
    <!-- CLUSTER BY syntax end-to-end: the SqlppClusterByVisitor rewrite desugars CLUSTER BY (sc descriptor +
         CLUSTER AS members) into the distributed k-means query and runs it on the tiny 2-D dataset. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-syntax">
            <output-dir compare="Text">kmeans-syntax</output-dir>
        </compilation-unit>
    </test-case>
    <!-- The same clause inside a view body and a function body: the function-body rewriter runs the
         CLUSTER BY rewrite too. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-in-view">
            <output-dir compare="Text">kmeans-in-view</output-dir>
        </compilation-unit>
    </test-case>
    <!-- The default kmeansPP initialization on a fixture with enough clusters to expose a bad candidate-pool
         reduction; the shared 6-point k=2 dataset converges correctly from any seeding and so cannot. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-init-kmeanspp">
            <output-dir compare="Text">kmeans-init-kmeanspp</output-dir>
        </compilation-unit>
    </test-case>
    <!-- init_mode "random" seeding: k vectors drawn uniformly (the k smallest row hashes), not the k
         lexicographically smallest vectors, which would be the k most similar points in the data set.
         Needs a fixture large enough for the two to differ; see the case's own comments. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-init-random">
            <output-dir compare="Text">kmeans-init-random</output-dir>
        </compilation-unit>
    </test-case>
    <!-- CLUSTER BY over an input of differing parallelism (a global LIMIT): the loop stages are pinned to one
         instance per compute partition, so the plan must repartition into them. Previously an
         ArrayIndexOutOfBoundsException at job-build time. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-limit-input">
            <output-dir compare="Text">kmeans-limit-input</output-dir>
        </compilation-unit>
    </test-case>
    <!-- CLUSTER BY under non-inlined WITH/LET compilation (SET inline_with false): guards the shared-subplan
         path; the desugar's own centroid LETs are always non-inlined via markNoInlineLetVar. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-syntax-noinline">
            <output-dir compare="Text">kmeans-syntax-noinline</output-dir>
        </compilation-unit>
    </test-case>
    <!-- The k-means|| init runtime operator path (SET cluster_by_runtime_init true): round 1 runs as the
         Store+Score operator; results must equal the pure-desugar reference path. -->
    <!-- init_mode "random": C0 = the k lexicographically smallest vectors, no k-means|| tower;
         the Lloyd stages and labeling are shared with the default kmeansPP mode. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-syntax-random">
            <output-dir compare="Text">kmeans-syntax-random</output-dir>
        </compilation-unit>
    </test-case>
    <!-- Negative cases: CLUSTER BY WITH-option validation (SqlppClusterByVisitor, rewrite phase).
         GROUP BY + CLUSTER BY mutual exclusion is enforced at the grammar level and covered by
         ClusterByParserTest, so it is not duplicated here. -->
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="missing-numclusters">
            <output-dir compare="Text">missing-numclusters</output-dir>
            <expected-error>CLUSTER BY requires the 'num_clusters' option.</expected-error>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="nonpositive-numclusters">
            <output-dir compare="Text">nonpositive-numclusters</output-dir>
            <expected-error>CLUSTER BY 'num_clusters' must be a positive integer</expected-error>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="missing-dimension">
            <output-dir compare="Text">missing-dimension</output-dir>
            <expected-error>CLUSTER BY with K-Means requires the 'dimension' option</expected-error>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="dimension-wrong-arity">
            <output-dir compare="Text">dimension-wrong-arity</output-dir>
            <expected-error>'dimension' must hold exactly one element</expected-error>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="dimension-not-array">
            <output-dir compare="Text">dimension-not-array</output-dir>
            <expected-error>CLUSTER BY 'dimension' must be an array of positive integers</expected-error>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="dimension-nonpositive">
            <output-dir compare="Text">dimension-nonpositive</output-dir>
            <expected-error>CLUSTER BY 'dimension' must be a positive integer</expected-error>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="unknown-option">
            <output-dir compare="Text">unknown-option</output-dir>
            <expected-error>Unknown CLUSTER BY option 'numcluster'</expected-error>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="unknown-init-mode">
            <output-dir compare="Text">unknown-init-mode</output-dir>
            <expected-error>Unknown CLUSTER BY 'init_mode' 'randm'</expected-error>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="unknown-distance">
            <output-dir compare="Text">unknown-distance</output-dir>
            <expected-error>CLUSTER BY 'similarity' 'euclidian' is not supported. Supported: COSINE, EUCLIDEAN, EUCLIDEAN_SQUARED.</expected-error>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="unsupported-distance">
            <output-dir compare="Text">unsupported-distance</output-dir>
            <expected-error>CLUSTER BY 'similarity' 'dot' is not supported</expected-error>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="unsupported-algorithm">
            <output-dir compare="Text">unsupported-algorithm</output-dir>
            <expected-error>Unsupported CLUSTER BY 'clustering_algorithm' 'DBSCAN'</expected-error>
        </compilation-unit>
    </test-case>
    <!-- A two-term FROM clause: the clustered vector comes from one dataset while the predicate spans both, so
         the rewrite rebuilds its input from the whole FROM clause rather than a single source variable. Four
         groups at k=4, with a year predicate that removes a quarter of the rows, so both the join and the filter
         are part of the assertion. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="join-in-from">
            <output-dir compare="Text">join-in-from</output-dir>
        </compilation-unit>
    </test-case>
    <!-- The same path reached through UNNEST of a nested array, where the second FROM term is correlated with
         the first rather than independent. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="unnest-in-from">
            <output-dir compare="Text">unnest-in-from</output-dir>
        </compilation-unit>
    </test-case>
    <!-- Cosine: two directions held at very different magnitudes, so Euclidean would group by magnitude and
         return {1,3},{2,4} instead. Passing means the metric reached both the loops and the labeling, and that
         the centroid update kept the centroids on the unit sphere. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="cosine-metric">
            <output-dir compare="Text">cosine-metric</output-dir>
        </compilation-unit>
    </test-case>
    <!-- v1 scope restrictions: no set operations. -->
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="setop-with-clusterby">
            <output-dir compare="Text">setop-with-clusterby</output-dir>
            <expected-error>CLUSTER BY is not supported with set operations (UNION/INTERSECT/EXCEPT).</expected-error>
        </compilation-unit>
    </test-case>
    <!-- Budget sensitivity: the same clustering at three memory budgets, the smallest of which cannot
         hold its working set and must spill every stage. All three arms share one expected result. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-budget-sensitivity">
            <output-dir compare="Text">kmeans-budget-sensitivity</output-dir>
        </compilation-unit>
    </test-case>
    <!-- The budget knob is live: below the declared 4-frame minimum the query is rejected before it
         runs. This is what keeps kmeans-budget-sensitivity honest, since an unregistered or ignored
         `compiler.clusterbymemory` would leave every arm at the default budget, agreeing trivially. -->
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="clusterbymemory-below-minimum">
            <output-dir compare="Text">clusterbymemory-below-minimum</output-dir>
            <expected-error>Invalid `compiler.clusterbymemory`</expected-error>
        </compilation-unit>
    </test-case>
    <!-- Fewer candidates attract rows than num_clusters, so fewer clusters are returned and the shortfall
         is reported. Two regimes: all-distinct input, where every candidate attracts rows, and duplicated
         input, where some attract none because an earlier candidate sits on the same point. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-more-clusters-than-data">
            <output-dir compare="Text">kmeans-more-clusters-than-data</output-dir>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-duplicate-points">
            <output-dir compare="Text">kmeans-duplicate-points</output-dir>
        </compilation-unit>
    </test-case>
    <!-- The cluster descriptor exposes exactly three fields, and the rewrite substitutes each away. A
         reference that survives is either an unknown field or the descriptor used whole; both must name the
         fields that exist rather than surface the rewrite's own variable as unresolved. -->
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="unknown-descriptor-field">
            <output-dir compare="Text">unknown-descriptor-field</output-dir>
            <expected-error>exposes only</expected-error>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="bare-descriptor">
            <output-dir compare="Text">bare-descriptor</output-dir>
            <expected-error>exposes only</expected-error>
        </compilation-unit>
    </test-case>
    <!-- Mixed widths and non-vector rows in one dataset, with membership written down. Declared Dimension
         decides who takes part, so the same rows cluster one way at 2 and the opposite way at 3. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-mixed-dimensions">
            <output-dir compare="Text">kmeans-mixed-dimensions</output-dir>
        </compilation-unit>
    </test-case>
    <!-- The same rows, with the warning the user gets for the ones left out; unpartitioned input so there is
         exactly one. -->
    <test-case FilePath="cluster-by" check-warnings="true">
        <compilation-unit name="kmeans-invalid-row-warning">
            <output-dir compare="Text">kmeans-invalid-row-warning</output-dir>
            <expected-warn>ASX0203: CLUSTER BY encountered invalid input: for some rows p.vec is not a numeric array of the declared dimension; they were left out of every cluster</expected-warn>
        </compilation-unit>
    </test-case>
    <!-- The two shortfall reports are raised by different stages and say different things. RECLUSTER knows
         the distinct-vector count and names it; Lloyd only knows what survived, so it names that instead.
         init_mode "random" has no RECLUSTER at all, which is why the Lloyd backstop has to exist. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-random-init-short">
            <output-dir compare="Text">kmeans-random-init-short</output-dir>
        </compilation-unit>
    </test-case>
    <!-- Initialization quality on structured data: four separable groups of unequal size must come back
         with their exact sizes. Guards the oversampling factor, which an inertia sweep alone did not. -->
    <!-- HAVING (and a LET before it) after the clause, over the descriptor and CLUSTER AS. -->
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-having">
            <output-dir compare="Text">kmeans-having</output-dir>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by" check-warnings="true">
        <compilation-unit name="kmeans-empty-input">
            <output-dir compare="Text">kmeans-empty-input</output-dir>
            <expected-warn>is not a numeric array of the declared dimension; they were left out of every cluster</expected-warn>
            <expected-warn>no row has a numeric array of the declared dimension under p.vec; no clusters are returned</expected-warn>
            <expected-warn>no row has a numeric array of dimension 2 under p.vec; no clusters are returned</expected-warn>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by" check-warnings="true">
        <compilation-unit name="kmeans-nonfinite-vectors">
            <output-dir compare="Text">kmeans-nonfinite-vectors</output-dir>
            <expected-warn>is not a numeric array of the declared dimension; they were left out of every cluster</expected-warn>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by" check-warnings="true">
        <compilation-unit name="kmeans-int-vectors">
            <output-dir compare="Text">kmeans-int-vectors</output-dir>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by" check-warnings="true">
        <compilation-unit name="kmeans-huge-k">
            <output-dir compare="Text">kmeans-huge-k</output-dir>
            <expected-warn>num_clusters is 5000 but the input has only 6 distinct vector(s); 6 cluster(s) are returned</expected-warn>
            <expected-warn>num_clusters is 5000 but the input only supports 6 cluster(s); 6 cluster(s) are returned</expected-warn>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="vector-exceeds-frame">
            <output-dir compare="Text">vector-exceeds-frame</output-dir>
            <expected-error>needs about 96064 bytes per vector, more than the frame size</expected-error>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-members-twice">
            <output-dir compare="Text">kmeans-members-twice</output-dir>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-in-join">
            <output-dir compare="Text">kmeans-in-join</output-dir>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-correlated">
            <output-dir compare="Text">kmeans-correlated</output-dir>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="outer-variable-after-clusterby">
            <output-dir compare="Text">outer-variable-after-clusterby</output-dir>
            <expected-error>CLUSTER BY: 'o' belongs to an enclosing query</expected-error>
            <expected-error>CLUSTER BY: 'o' belongs to an enclosing query</expected-error>
            <expected-error>ASX1073: Cannot resolve alias reference for undefined identifier p</expected-error>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="having-reads-from-binding">
            <output-dir compare="Text">having-reads-from-binding</output-dir>
            <expected-error>ASX1073: Cannot resolve alias reference for undefined identifier p</expected-error>
            <expected-error>ASX1073: Cannot resolve alias reference for undefined identifier v</expected-error>
            <expected-error>ASX1073: Cannot resolve alias reference for undefined identifier p</expected-error>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-sql92-aggregates">
            <output-dir compare="Text">kmeans-sql92-aggregates</output-dir>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-decor">
            <output-dir compare="Text">kmeans-decor</output-dir>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by">
        <compilation-unit name="kmeans-let-in-block">
            <output-dir compare="Text">kmeans-let-in-block</output-dir>
        </compilation-unit>
    </test-case>
    <test-case FilePath="cluster-by/negative">
        <compilation-unit name="correlated-clusterby-subquery">
            <output-dir compare="Text">correlated-clusterby-subquery</output-dir>
            <expected-error>CLUSTER BY: 'o' belongs to an enclosing query</expected-error>
            <expected-error>CLUSTER BY: 'o' belongs to an enclosing query</expected-error>
            <expected-error>CLUSTER BY: 'o' belongs to an enclosing query</expected-error>
            <expected-error>CLUSTER BY: 'o' belongs to an enclosing query</expected-error>
            <expected-error>CLUSTER BY: 'k' belongs to an enclosing query</expected-error>
        </compilation-unit>
    </test-case>
</test-group>
