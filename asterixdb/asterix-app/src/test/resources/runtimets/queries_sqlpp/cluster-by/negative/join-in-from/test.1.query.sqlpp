-- APE 33 Database Design #3 (reviews nested inside movies): UNNEST attaches a correlate clause to the
-- FROM term, which v1 CLUSTER BY must reject at compile time.
from [{"movie_year": 2019, "reviews": [{"reviewEmbedding": [1.0, 2.0]}]}] as m
unnest m.reviews as re
cluster by re.reviewEmbedding as sc
cluster as rvc
with { "NumClusters": 5 }
select sc.cluster_id as cid, array_count(rvc) as cnt, rvc;
