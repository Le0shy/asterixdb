// create scheduler config 2:
CREATE SCHEDULER CONFIG s_config_2 AS{
    "defaultPriority": 1,
    "shortMemoryPercent": 10.0,
    "shortCPUQuota": 3,
        "queryGroup":
        [
        {
            "priority": 4,
            "grouplist": [ "ui"]
        },


        {
            "priority" : 6,
            "grouplist": ["analytics"]
        },

        {
            "priority" : 8,
            "grouplist": ["ad-hoc"]
        }
    ]
};