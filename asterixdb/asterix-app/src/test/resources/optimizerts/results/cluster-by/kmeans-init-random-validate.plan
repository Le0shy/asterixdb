distribute result [$$86]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    assign [$$86] <- [{"cid": $#1}] project: [$$86]
    -- ASSIGN  |PARTITIONED|
      exchange
      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
        group by ([$#1 := $$95]) decor ([]) {
                  aggregate [] <- [] [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                  -- AGGREGATE  |LOCAL|
                    nested tuple source [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                    -- NESTED_TUPLE_SOURCE  |LOCAL|
               }
        -- SORT_GROUP_BY[$$95]  |PARTITIONED|
          exchange
          -- HASH_PARTITION_EXCHANGE [$$95]  |PARTITIONED|
            project ([$$95])
            -- STREAM_PROJECT  |PARTITIONED|
              exchange
              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                kmeans-stage $$95 <- lloyd-loop $$87 vs pool $$89 by euclidean_squared
                -- KMEANS_LLOYD_LOOP  |PARTITIONED|
                  exchange
                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                    assign [$$87] <- [$$89] project: [$$87]
                    -- ASSIGN  |PARTITIONED|
                      exchange
                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                        replicate
                        -- REPLICATE  |PARTITIONED|
                          exchange
                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                            assign [$$90] <- [{"r": $$91}] project: [$$89, $$90, $$89]
                            -- ASSIGN  |PARTITIONED|
                              select (and(is-array($$89), eq(len($$89), 2)))
                              -- STREAM_SELECT  |PARTITIONED|
                                assign [$$89] <- [$$91.getField(1)]
                                -- ASSIGN  |PARTITIONED|
                                  project ([$$91])
                                  -- STREAM_PROJECT  |PARTITIONED|
                                    exchange
                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                      data-scan []<-[$$92, $$91] <- clusterby_test.Reviews
                                      -- DATASOURCE_SCAN  |PARTITIONED|
                                        exchange
                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                          empty-tuple-source
                                          -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                  exchange
                  -- BROADCAST_EXCHANGE  |PARTITIONED|
                    limit 3
                    -- STREAM_LIMIT  |UNPARTITIONED|
                      project ([$$89])
                      -- STREAM_PROJECT  |PARTITIONED|
                        exchange
                        -- SORT_MERGE_EXCHANGE [$$93(ASC) ]  |PARTITIONED|
                          limit 3
                          -- STREAM_LIMIT  |PARTITIONED|
                            exchange
                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                              order (topK: 3) (ASC, $$93)
                              -- STABLE_SORT [topK: 3] [$$93(ASC)]  |PARTITIONED|
                                exchange
                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                  assign [$$93] <- [random(get-item($$89, 0))]
                                  -- ASSIGN  |PARTITIONED|
                                    exchange
                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                      replicate
                                      -- REPLICATE  |PARTITIONED|
                                        exchange
                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                          assign [$$90] <- [{"r": $$91}] project: [$$89, $$90, $$89]
                                          -- ASSIGN  |PARTITIONED|
                                            select (and(is-array($$89), eq(len($$89), 2)))
                                            -- STREAM_SELECT  |PARTITIONED|
                                              assign [$$89] <- [$$91.getField(1)]
                                              -- ASSIGN  |PARTITIONED|
                                                project ([$$91])
                                                -- STREAM_PROJECT  |PARTITIONED|
                                                  exchange
                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                    data-scan []<-[$$92, $$91] <- clusterby_test.Reviews
                                                    -- DATASOURCE_SCAN  |PARTITIONED|
                                                      exchange
                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                        empty-tuple-source
                                                        -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
