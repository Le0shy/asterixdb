distribute result [$$96]
-- DISTRIBUTE_RESULT  |LOCAL|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |LOCAL|
    assign [$$96] <- [{"cid": $#1}] project: [$$96]
    -- ASSIGN  |LOCAL|
      exchange
      -- ONE_TO_ONE_EXCHANGE  |LOCAL|
        group by ([$#1 := $$107]) decor ([]) {
                  aggregate [] <- [] [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                  -- AGGREGATE  |UNPARTITIONED|
                    nested tuple source [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                    -- NESTED_TUPLE_SOURCE  |UNPARTITIONED|
               }
        -- SORT_GROUP_BY[$$107]  |LOCAL|
          exchange
          -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
            select (not(is-unknown($$107)))
            -- STREAM_SELECT  |UNPARTITIONED|
              assign [$$107] <- [nearest-centroid($$93, $$106, "euclidean_squared")] project: [$$93, $$94, $$107]
              -- ASSIGN  |UNPARTITIONED|
                exchange
                -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                  join (true)
                  -- NESTED_LOOP  |UNPARTITIONED|
                    exchange
                    -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                      replicate
                      -- REPLICATE  |UNPARTITIONED|
                        exchange
                        -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                          assign [$$94] <- [{"t": $$r}] project: [$$93, $$94]
                          -- ASSIGN  |UNPARTITIONED|
                            limit 100
                            -- STREAM_LIMIT  |UNPARTITIONED|
                              assign [$$93] <- [$$r.getField(1)]
                              -- ASSIGN  |PARTITIONED|
                                project ([$$r])
                                -- STREAM_PROJECT  |PARTITIONED|
                                  exchange
                                  -- SORT_MERGE_EXCHANGE [$$97(ASC) ]  |PARTITIONED|
                                    limit 100
                                    -- STREAM_LIMIT  |PARTITIONED|
                                      limit 100
                                      -- STREAM_LIMIT  |PARTITIONED|
                                        limit 100
                                        -- STREAM_LIMIT  |PARTITIONED|
                                          limit 100
                                          -- STREAM_LIMIT  |PARTITIONED|
                                            exchange
                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                              order (topK: 100) (ASC, $$97)
                                              -- STABLE_SORT [topK: 100] [$$97(ASC)]  |PARTITIONED|
                                                exchange
                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                  data-scan []<-[$$97, $$r] <- clusterby_test.Reviews
                                                  -- DATASOURCE_SCAN  |PARTITIONED|
                                                    exchange
                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                      empty-tuple-source
                                                      -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                    exchange
                    -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                      aggregate [$$106] <- [listify($$105)]
                      -- AGGREGATE  |UNPARTITIONED|
                        exchange
                        -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                          order (ASC, $$105)
                          -- STABLE_SORT [$$105(ASC)]  |UNPARTITIONED|
                            exchange
                            -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                              kmeans-stage $$105 <- lloyd-loop $$104 vs pool $$103 by euclidean_squared
                              -- KMEANS_LLOYD_LOOP  |UNPARTITIONED|
                                exchange
                                -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                                  assign [$$104] <- [$$93]
                                  -- ASSIGN  |UNPARTITIONED|
                                    exchange
                                    -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                                      replicate
                                      -- REPLICATE  |UNPARTITIONED|
                                        exchange
