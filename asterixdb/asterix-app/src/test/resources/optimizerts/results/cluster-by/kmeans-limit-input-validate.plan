                                                  -- ASSIGN  |UNPARTITIONED|
                                                    limit 100
                                                    -- STREAM_LIMIT  |UNPARTITIONED|
                                                      assign [$$93] <- [$$r.getField(1)]
                                                      -- ASSIGN  |PARTITIONED|
                                                        project ([$$r])
                                                        -- STREAM_PROJECT  |PARTITIONED|
                                                          exchange
                                                          -- SORT_MERGE_EXCHANGE [$$97(ASC) ]  |PARTITIONED|
                                                            limit 100
                                                            -- STREAM_LIMIT  |PARTITIONED|
                                                              limit 100
                                                              -- STREAM_LIMIT  |PARTITIONED|
                                                                limit 100
                                                                -- STREAM_LIMIT  |PARTITIONED|
                                                                  limit 100
                                                                  -- STREAM_LIMIT  |PARTITIONED|
                                                                    exchange
                                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                      order (topK: 100) (ASC, $$97)
                                                                      -- STABLE_SORT [topK: 100] [$$97(ASC)]  |PARTITIONED|
                                                                        exchange
                                                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                          data-scan []<-[$$97, $$r] <- clusterby_test.Reviews
                                                                          -- DATASOURCE_SCAN  |PARTITIONED|
                                                                            exchange
                                                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                              empty-tuple-source
                                                                              -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                        exchange
                                        -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                                          limit 1
                                          -- STREAM_LIMIT  |UNPARTITIONED|
                                            project ([$$93, $$94, $$99])
                                            -- STREAM_PROJECT  |UNPARTITIONED|
                                              exchange
                                              -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                                                order (topK: 1) (ASC, $$100)
                                                -- STABLE_SORT [topK: 1] [$$100(ASC)]  |UNPARTITIONED|
                                                  exchange
                                                  -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                                                    assign [$$100] <- [random(get-item($$99, 0))]
                                                    -- ASSIGN  |UNPARTITIONED|
                                                      select (and(is-array($$99), eq(sql-count($$99), 2)))
                                                      -- STREAM_SELECT  |UNPARTITIONED|
                                                        assign [$$99] <- [$$93]
                                                        -- ASSIGN  |UNPARTITIONED|
                                                          exchange
                                                          -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                                                            replicate
                                                            -- REPLICATE  |UNPARTITIONED|
                                                              exchange
