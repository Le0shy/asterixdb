distribute result [$$102]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    assign [$$102] <- [{"cid": $#1}] project: [$$102]
    -- ASSIGN  |PARTITIONED|
      exchange
      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
        group by ([$#1 := $$118]) decor ([]) {
                  aggregate [] <- [] [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                  -- AGGREGATE  |LOCAL|
                    nested tuple source [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                    -- NESTED_TUPLE_SOURCE  |LOCAL|
               }
        -- SORT_GROUP_BY[$$118]  |PARTITIONED|
          exchange
          -- HASH_PARTITION_EXCHANGE [$$118]  |PARTITIONED|
            project ([$$118])
            -- STREAM_PROJECT  |PARTITIONED|
              exchange
              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                kmeans-stage $$118 <- lloyd-loop $$103 vs pool $$116 by euclidean_squared
                -- KMEANS_LLOYD_LOOP  |PARTITIONED|
                  exchange
                  -- RANDOM_PARTITION_EXCHANGE  |PARTITIONED|
                    assign [$$100] <- [{"t": $$r}] project: [$$103, $$100, $$103]
                    -- ASSIGN  |UNPARTITIONED|
                      limit 100
                      -- STREAM_LIMIT  |UNPARTITIONED|
                        project ([$$r, $$103])
                        -- STREAM_PROJECT  |PARTITIONED|
                          exchange
                          -- SORT_MERGE_EXCHANGE [$$104(ASC) ]  |PARTITIONED|
                            limit 100
                            -- STREAM_LIMIT  |PARTITIONED|
                              exchange
                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                order (topK: 100) (ASC, $$104)
                                -- STABLE_SORT [topK: 100] [$$104(ASC)]  |PARTITIONED|
                                  exchange
                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                    assign [$$104, $$r, $$103] <- [$$109, $$108, $$106] project: [$$104, $$r, $$103]
                                    -- ASSIGN  |PARTITIONED|
                                      exchange
                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                        replicate
                                        -- REPLICATE  |PARTITIONED|
                                          exchange
                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                            select (and(eq(len($$106), 2), is-array($$106)))
                                            -- STREAM_SELECT  |PARTITIONED|
                                              assign [$$106] <- [$$108.getField(1)]
                                              -- ASSIGN  |PARTITIONED|
                                                exchange
                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                  data-scan []<-[$$109, $$108] <- clusterby_test.Reviews
                                                  -- DATASOURCE_SCAN  |PARTITIONED|
                                                    exchange
                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                      empty-tuple-source
                                                      -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                  exchange
                  -- BROADCAST_EXCHANGE  |PARTITIONED|
                    kmeans-stage $$116 <- recluster pool $$115 to 2 means by euclidean_squared
                    -- KMEANS_RECLUSTER  |PARTITIONED|
                      exchange
                      -- BROADCAST_EXCHANGE  |PARTITIONED|
                        kmeans-stage $$115 <- oversample-loop 5 rounds of $$111 vs seed $$106 by euclidean_squared
                        -- KMEANS_OVERSAMPLE_LOOP  |PARTITIONED|
                          exchange
                          -- RANDOM_PARTITION_EXCHANGE  |PARTITIONED|
                            assign [$$112] <- [{"t": $$113}] project: [$$111, $$112, $$111]
                            -- ASSIGN  |UNPARTITIONED|
                              limit 100
                              -- STREAM_LIMIT  |UNPARTITIONED|
                                project ([$$113, $$111])
                                -- STREAM_PROJECT  |PARTITIONED|
                                  exchange
                                  -- SORT_MERGE_EXCHANGE [$$114(ASC) ]  |PARTITIONED|
                                    limit 100
                                    -- STREAM_LIMIT  |PARTITIONED|
                                      exchange
                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                        order (topK: 100) (ASC, $$114)
                                        -- STABLE_SORT [topK: 100] [$$114(ASC)]  |PARTITIONED|
                                          exchange
                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                            assign [$$114, $$113, $$111] <- [$$109, $$108, $$106] project: [$$114, $$113, $$111]
                                            -- ASSIGN  |PARTITIONED|
                                              exchange
                                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                replicate
                                                -- REPLICATE  |PARTITIONED|
                                                  exchange
                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                    select (and(eq(len($$106), 2), is-array($$106)))
                                                    -- STREAM_SELECT  |PARTITIONED|
                                                      assign [$$106] <- [$$108.getField(1)]
                                                      -- ASSIGN  |PARTITIONED|
                                                        exchange
                                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                          data-scan []<-[$$109, $$108] <- clusterby_test.Reviews
                                                          -- DATASOURCE_SCAN  |PARTITIONED|
                                                            exchange
                                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                              empty-tuple-source
                                                              -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                          exchange
                          -- BROADCAST_EXCHANGE  |PARTITIONED|
                            limit 1
                            -- STREAM_LIMIT  |UNPARTITIONED|
                              project ([$$106])
                              -- STREAM_PROJECT  |UNPARTITIONED|
                                exchange
                                -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                                  order (topK: 1) (ASC, $$110)
                                  -- STABLE_SORT [topK: 1] [$$110(ASC)]  |UNPARTITIONED|
                                    exchange
                                    -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                                      assign [$$110] <- [random(get-item($$106, 0))]
                                      -- ASSIGN  |UNPARTITIONED|
                                        assign [$$107] <- [{"t": $$108}] project: [$$106, $$107, $$106]
                                        -- ASSIGN  |UNPARTITIONED|
                                          limit 100
                                          -- STREAM_LIMIT  |UNPARTITIONED|
                                            project ([$$108, $$106])
                                            -- STREAM_PROJECT  |PARTITIONED|
                                              exchange
                                              -- SORT_MERGE_EXCHANGE [$$109(ASC) ]  |PARTITIONED|
                                                limit 100
                                                -- STREAM_LIMIT  |PARTITIONED|
                                                  exchange
                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                    order (topK: 100) (ASC, $$109)
                                                    -- STABLE_SORT [topK: 100] [$$109(ASC)]  |PARTITIONED|
                                                      exchange
                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                        replicate
                                                        -- REPLICATE  |PARTITIONED|
                                                          exchange
                                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                            select (and(eq(len($$106), 2), is-array($$106)))
                                                            -- STREAM_SELECT  |PARTITIONED|
                                                              assign [$$106] <- [$$108.getField(1)]
                                                              -- ASSIGN  |PARTITIONED|
                                                                exchange
                                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                  data-scan []<-[$$109, $$108] <- clusterby_test.Reviews
                                                                  -- DATASOURCE_SCAN  |PARTITIONED|
                                                                    exchange
                                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                      empty-tuple-source
                                                                      -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
