                                                                  data-scan []<-[$$97, $$r] <- clusterby_test.Reviews
                                                                  -- DATASOURCE_SCAN  |PARTITIONED|
                                                                    exchange
                                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                      empty-tuple-source
                                                                      -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                exchange
                                -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                                  kmeans-stage $$103 <- recluster pool $$102 to 2 means by euclidean_squared
                                  -- KMEANS_RECLUSTER  |UNPARTITIONED|
                                    exchange
                                    -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                                      kmeans-stage $$102 <- oversample-loop 5 rounds of $$101 vs seed $$99 by euclidean_squared
                                      -- KMEANS_OVERSAMPLE_LOOP  |UNPARTITIONED|
                                        exchange
                                        -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                                          assign [$$101] <- [$$93]
                                          -- ASSIGN  |UNPARTITIONED|
                                            exchange
                                            -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
                                              replicate
