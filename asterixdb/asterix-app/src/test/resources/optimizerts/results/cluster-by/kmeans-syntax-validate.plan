distribute result [$$80]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    assign [$$80] <- [{"cid": $#1, "centroid": $#2}] project: [$$80]
    -- ASSIGN  |PARTITIONED|
      exchange
      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
        group by ([$#1 := $$90]) decor ([]) {
                  aggregate [$#2] <- [agg-centroid($$77)] [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                  -- AGGREGATE  |LOCAL|
                    nested tuple source [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                    -- NESTED_TUPLE_SOURCE  |LOCAL|
               }
        -- SORT_GROUP_BY[$$90]  |PARTITIONED|
          exchange
          -- HASH_PARTITION_EXCHANGE [$$90]  |PARTITIONED|
            select (not(is-unknown($$90)))
            -- STREAM_SELECT  |PARTITIONED|
              assign [$$90] <- [nearest-centroid($$77, $$89, "euclidean_squared", "r.reviewEmbedding")] project: [$$77, $$78, $$90]
              -- ASSIGN  |PARTITIONED|
                exchange
                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                  join (true)
                  -- NESTED_LOOP  |PARTITIONED|
                    exchange
                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                      replicate
                      -- REPLICATE  |PARTITIONED|
                        exchange
                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                          assign [$$78, $$77] <- [{"r": $$r}, $$r.getField(1)] project: [$$77, $$78]
                          -- ASSIGN  |PARTITIONED|
                            project ([$$r])
                            -- STREAM_PROJECT  |PARTITIONED|
                              exchange
                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                data-scan []<-[$$81, $$r] <- clusterby_test.Reviews
                                -- DATASOURCE_SCAN  |PARTITIONED|
                                  exchange
                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                    empty-tuple-source
                                    -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                    exchange
                    -- BROADCAST_EXCHANGE  |PARTITIONED|
                      aggregate [$$89] <- [listify($$88)]
                      -- AGGREGATE  |UNPARTITIONED|
                        exchange
                        -- SORT_MERGE_EXCHANGE [$$88(ASC) ]  |PARTITIONED|
                          order (ASC, $$88)
                          -- STABLE_SORT [$$88(ASC)]  |PARTITIONED|
                            exchange
                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                              kmeans-stage $$88 <- lloyd-loop $$87 vs pool $$86 by euclidean_squared
                              -- KMEANS_LLOYD_LOOP  |PARTITIONED|
                                exchange
                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                  assign [$$87] <- [$$77]
                                  -- ASSIGN  |PARTITIONED|
                                    exchange
                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                      replicate
                                      -- REPLICATE  |PARTITIONED|
                                        exchange
                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                          assign [$$78, $$77] <- [{"r": $$r}, $$r.getField(1)] project: [$$77, $$78]
                                          -- ASSIGN  |PARTITIONED|
                                            project ([$$r])
                                            -- STREAM_PROJECT  |PARTITIONED|
                                              exchange
                                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                data-scan []<-[$$81, $$r] <- clusterby_test.Reviews
                                                -- DATASOURCE_SCAN  |PARTITIONED|
                                                  exchange
                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                    empty-tuple-source
                                                    -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                exchange
                                -- BROADCAST_EXCHANGE  |PARTITIONED|
                                  kmeans-stage $$86 <- recluster pool $$85 to 2 means by euclidean_squared
                                  -- KMEANS_RECLUSTER  |PARTITIONED|
                                    exchange
                                    -- BROADCAST_EXCHANGE  |PARTITIONED|
                                      kmeans-stage $$85 <- oversample-loop 5 rounds of $$84 vs seed $$82 by euclidean_squared
                                      -- KMEANS_OVERSAMPLE_LOOP  |PARTITIONED|
                                        exchange
                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                          assign [$$84] <- [$$77]
                                          -- ASSIGN  |PARTITIONED|
                                            exchange
                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                              replicate
                                              -- REPLICATE  |PARTITIONED|
                                                exchange
                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                  assign [$$78, $$77] <- [{"r": $$r}, $$r.getField(1)] project: [$$77, $$78]
                                                  -- ASSIGN  |PARTITIONED|
                                                    project ([$$r])
                                                    -- STREAM_PROJECT  |PARTITIONED|
                                                      exchange
                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                        data-scan []<-[$$81, $$r] <- clusterby_test.Reviews
                                                        -- DATASOURCE_SCAN  |PARTITIONED|
                                                          exchange
                                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                            empty-tuple-source
                                                            -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                        exchange
                                        -- BROADCAST_EXCHANGE  |PARTITIONED|
                                          limit 1
                                          -- STREAM_LIMIT  |UNPARTITIONED|
                                            project ([$$77, $$78, $$82])
                                            -- STREAM_PROJECT  |PARTITIONED|
                                              exchange
                                              -- SORT_MERGE_EXCHANGE [$$83(ASC) ]  |PARTITIONED|
                                                limit 1
                                                -- STREAM_LIMIT  |PARTITIONED|
                                                  exchange
                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                    order (ASC, $$83)
                                                    -- STABLE_SORT [$$83(ASC)]  |PARTITIONED|
                                                      exchange
                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                        assign [$$83] <- [random(get-item($$82, 0))]
                                                        -- ASSIGN  |PARTITIONED|
                                                          select (and(is-array($$82), eq(sql-count($$82), 2)))
                                                          -- STREAM_SELECT  |PARTITIONED|
                                                            assign [$$82] <- [$$77]
                                                            -- ASSIGN  |PARTITIONED|
                                                              exchange
                                                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                replicate
                                                                -- REPLICATE  |PARTITIONED|
                                                                  exchange
                                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                    assign [$$78, $$77] <- [{"r": $$r}, $$r.getField(1)] project: [$$77, $$78]
                                                                    -- ASSIGN  |PARTITIONED|
                                                                      project ([$$r])
                                                                      -- STREAM_PROJECT  |PARTITIONED|
                                                                        exchange
                                                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                          data-scan []<-[$$81, $$r] <- clusterby_test.Reviews
                                                                          -- DATASOURCE_SCAN  |PARTITIONED|
                                                                            exchange
                                                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                              empty-tuple-source
                                                                              -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
