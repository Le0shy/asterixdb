distribute result [$$210]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    assign [$$210] <- [{"cid": $#5, "centroid": $$220}] project: [$$210]
    -- ASSIGN  |PARTITIONED|
      exchange
      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
        group by ([$#5 := $$224]) decor ([]) {
                  aggregate [$$220] <- [agg-global-sql-centroid($$223)] [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                  -- AGGREGATE  |LOCAL|
                    nested tuple source [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                    -- NESTED_TUPLE_SOURCE  |LOCAL|
               }
        -- SORT_GROUP_BY[$$224]  |PARTITIONED|
          exchange
          -- HASH_PARTITION_EXCHANGE [$$224]  |PARTITIONED|
            group by ([$$224 := $$222]) decor ([]) {
                      aggregate [$$223] <- [agg-local-sql-centroid($$214)] [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                      -- AGGREGATE  |LOCAL|
                        nested tuple source [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                        -- NESTED_TUPLE_SOURCE  |LOCAL|
                   }
            -- SORT_GROUP_BY[$$222]  |PARTITIONED|
              exchange
              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                select (and(is-array($$214), eq(len($$214), 2), not(is-unknown($$222))))
                -- STREAM_SELECT  |PARTITIONED|
                  assign [$$222] <- [nearest-centroid($$214, $$188, "euclidean_squared")] project: [$$214, $$222]
                  -- ASSIGN  |PARTITIONED|
                    assign [$$214] <- [$$r.getField(1)] project: [$$188, $$214]
                    -- ASSIGN  |PARTITIONED|
                      project ([$$188, $$r])
                      -- STREAM_PROJECT  |PARTITIONED|
                        exchange
                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                          data-scan []<-[$$218, $$r] <- clusterby_test.Reviews
                          -- DATASOURCE_SCAN  |PARTITIONED|
                            exchange
                            -- BROADCAST_EXCHANGE  |PARTITIONED|
                              aggregate [$$188] <- [listify($$184)]
                              -- AGGREGATE  |UNPARTITIONED|
                                exchange
                                -- SORT_MERGE_EXCHANGE [$$184(ASC) ]  |PARTITIONED|
                                  order (ASC, $$184)
                                  -- STABLE_SORT [$$184(ASC)]  |PARTITIONED|
                                    exchange
                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                      kmeans-stage $$184 <- lloyd-loop $$212 vs pool $$182 by euclidean_squared
                                      -- KMEANS_LLOYD_LOOP  |PARTITIONED|
                                        exchange
                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                          assign [$$212] <- [$$213] project: [$$212]
                                          -- ASSIGN  |PARTITIONED|
                                            exchange
                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                              replicate
                                              -- REPLICATE  |PARTITIONED|
                                                exchange
                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                  assign [$$213] <- [$$219] project: [$$213]
                                                  -- ASSIGN  |PARTITIONED|
                                                    exchange
                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                      replicate
                                                      -- REPLICATE  |PARTITIONED|
                                                        exchange
                                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                          select (and(is-array($$219), eq(len($$219), 2)))
                                                          -- STREAM_SELECT  |PARTITIONED|
                                                            assign [$$219] <- [$$r.getField(1)] project: [$$219]
                                                            -- ASSIGN  |PARTITIONED|
                                                              project ([$$r])
                                                              -- STREAM_PROJECT  |PARTITIONED|
                                                                exchange
                                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                  data-scan []<-[$$217, $$r] <- clusterby_test.Reviews
                                                                  -- DATASOURCE_SCAN  |PARTITIONED|
                                                                    exchange
                                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                      empty-tuple-source
                                                                      -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                        exchange
                                        -- BROADCAST_EXCHANGE  |PARTITIONED|
                                          kmeans-stage $$182 <- recluster pool $$180 to 2 means by euclidean_squared
                                          -- KMEANS_RECLUSTER  |PARTITIONED|
                                            exchange
                                            -- BROADCAST_EXCHANGE  |PARTITIONED|
                                              kmeans-stage $$180 <- oversample-loop 5 rounds of $$213 vs seed $$219 by euclidean_squared
                                              -- KMEANS_OVERSAMPLE_LOOP  |PARTITIONED|
                                                exchange
                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                  replicate
                                                  -- REPLICATE  |PARTITIONED|
                                                    exchange
                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                      assign [$$213] <- [$$219] project: [$$213]
                                                      -- ASSIGN  |PARTITIONED|
                                                        exchange
                                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                          replicate
                                                          -- REPLICATE  |PARTITIONED|
                                                            exchange
                                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                              select (and(is-array($$219), eq(len($$219), 2)))
                                                              -- STREAM_SELECT  |PARTITIONED|
                                                                assign [$$219] <- [$$r.getField(1)] project: [$$219]
                                                                -- ASSIGN  |PARTITIONED|
                                                                  project ([$$r])
                                                                  -- STREAM_PROJECT  |PARTITIONED|
                                                                    exchange
                                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                      data-scan []<-[$$217, $$r] <- clusterby_test.Reviews
                                                                      -- DATASOURCE_SCAN  |PARTITIONED|
                                                                        exchange
                                                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                          empty-tuple-source
                                                                          -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                                exchange
                                                -- BROADCAST_EXCHANGE  |PARTITIONED|
                                                  limit 1
                                                  -- STREAM_LIMIT  |UNPARTITIONED|
                                                    project ([$$219])
                                                    -- STREAM_PROJECT  |PARTITIONED|
                                                      exchange
                                                      -- SORT_MERGE_EXCHANGE [$$177(ASC) ]  |PARTITIONED|
                                                        limit 1
                                                        -- STREAM_LIMIT  |PARTITIONED|
                                                          exchange
                                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                            order (topK: 1) (ASC, $$177)
                                                            -- STABLE_SORT [topK: 1] [$$177(ASC)]  |PARTITIONED|
                                                              exchange
                                                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                assign [$$177] <- [random(get-item($$219, 0))]
                                                                -- ASSIGN  |PARTITIONED|
                                                                  exchange
                                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                    replicate
                                                                    -- REPLICATE  |PARTITIONED|
                                                                      exchange
                                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                        select (and(is-array($$219), eq(len($$219), 2)))
                                                                        -- STREAM_SELECT  |PARTITIONED|
                                                                          assign [$$219] <- [$$r.getField(1)] project: [$$219]
                                                                          -- ASSIGN  |PARTITIONED|
                                                                            project ([$$r])
                                                                            -- STREAM_PROJECT  |PARTITIONED|
                                                                              exchange
                                                                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                                data-scan []<-[$$217, $$r] <- clusterby_test.Reviews
                                                                                -- DATASOURCE_SCAN  |PARTITIONED|
                                                                                  exchange
                                                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                                    empty-tuple-source
                                                                                    -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
