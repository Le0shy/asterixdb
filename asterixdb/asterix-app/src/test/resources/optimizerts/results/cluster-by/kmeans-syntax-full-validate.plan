distribute result [$$138]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    assign [$$138] <- [{"cid": $#4, "cnt": $$144, "movieCluster": $$135}] project: [$$138]
    -- ASSIGN  |PARTITIONED|
      exchange
      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
        group by ([$#4 := $$147]) decor ([]) {
                  aggregate [$$135, $$144] <- [listify($$132), agg-sql-count($$132)] [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                  -- AGGREGATE  |LOCAL|
                    nested tuple source [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                    -- NESTED_TUPLE_SOURCE  |LOCAL|
               }
        -- PRE_CLUSTERED_GROUP_BY[$$147]  |PARTITIONED|
          exchange
          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
            order (ASC, $$147)
            -- STABLE_SORT [$$147(ASC)]  |PARTITIONED|
              exchange
              -- HASH_PARTITION_EXCHANGE [$$147]  |PARTITIONED|
                assign [$$132] <- [{"m": $$m}] project: [$$132, $$147]
                -- ASSIGN  |PARTITIONED|
                  select (and(is-array($$141), eq(len($$141), 2), not(is-unknown($$147)), lt($$m.getField(1), 2020))) project: [$$m, $$147]
                  -- STREAM_SELECT  |PARTITIONED|
                    assign [$$147] <- [nearest-centroid($$141, $$118, "euclidean_squared")] project: [$$m, $$141, $$147]
                    -- ASSIGN  |PARTITIONED|
                      assign [$$141] <- [$$m.getField(2)]
                      -- ASSIGN  |PARTITIONED|
                        project ([$$118, $$m])
                        -- STREAM_PROJECT  |PARTITIONED|
                          exchange
                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                            data-scan []<-[$$143, $$m] <- clusterby_test.movies
                            -- DATASOURCE_SCAN  |PARTITIONED|
                              exchange
                              -- BROADCAST_EXCHANGE  |PARTITIONED|
                                aggregate [$$118] <- [listify($$114)]
                                -- AGGREGATE  |UNPARTITIONED|
                                  exchange
                                  -- SORT_MERGE_EXCHANGE [$$114(ASC) ]  |PARTITIONED|
                                    order (ASC, $$114)
                                    -- STABLE_SORT [$$114(ASC)]  |PARTITIONED|
                                      exchange
                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                        kmeans-stage $$114 <- lloyd-loop $$140 vs pool $$158 by euclidean_squared
                                        -- KMEANS_LLOYD_LOOP  |PARTITIONED|
                                          exchange
                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                            assign [$$140] <- [$$153] project: [$$140]
                                            -- ASSIGN  |PARTITIONED|
                                              exchange
                                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                replicate
                                                -- REPLICATE  |PARTITIONED|
                                                  exchange
                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                    assign [$$153] <- [$$148] project: [$$153]
                                                    -- ASSIGN  |PARTITIONED|
                                                      exchange
                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                        replicate
                                                        -- REPLICATE  |PARTITIONED|
                                                          exchange
                                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                            select (and(lt($$150.getField(1), 2020), eq(len($$148), 2), is-array($$148))) project: [$$148]
                                                            -- STREAM_SELECT  |PARTITIONED|
                                                              assign [$$148] <- [$$150.getField(2)]
                                                              -- ASSIGN  |PARTITIONED|
                                                                project ([$$150])
                                                                -- STREAM_PROJECT  |PARTITIONED|
                                                                  exchange
                                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                    data-scan []<-[$$151, $$150] <- clusterby_test.movies
                                                                    -- DATASOURCE_SCAN  |PARTITIONED|
                                                                      exchange
                                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                        empty-tuple-source
                                                                        -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                          exchange
                                          -- BROADCAST_EXCHANGE  |PARTITIONED|
                                            kmeans-stage $$158 <- recluster pool $$157 to 5 means by euclidean_squared
                                            -- KMEANS_RECLUSTER  |PARTITIONED|
                                              exchange
                                              -- BROADCAST_EXCHANGE  |PARTITIONED|
                                                kmeans-stage $$157 <- oversample-loop 5 rounds of $$153 vs seed $$148 by euclidean_squared
                                                -- KMEANS_OVERSAMPLE_LOOP  |PARTITIONED|
                                                  exchange
                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                    replicate
                                                    -- REPLICATE  |PARTITIONED|
                                                      exchange
                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                        assign [$$153] <- [$$148] project: [$$153]
                                                        -- ASSIGN  |PARTITIONED|
                                                          exchange
                                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                            replicate
                                                            -- REPLICATE  |PARTITIONED|
                                                              exchange
                                                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                select (and(lt($$150.getField(1), 2020), eq(len($$148), 2), is-array($$148))) project: [$$148]
                                                                -- STREAM_SELECT  |PARTITIONED|
                                                                  assign [$$148] <- [$$150.getField(2)]
                                                                  -- ASSIGN  |PARTITIONED|
                                                                    project ([$$150])
                                                                    -- STREAM_PROJECT  |PARTITIONED|
                                                                      exchange
                                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                        data-scan []<-[$$151, $$150] <- clusterby_test.movies
                                                                        -- DATASOURCE_SCAN  |PARTITIONED|
                                                                          exchange
                                                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                            empty-tuple-source
                                                                            -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                                  exchange
                                                  -- BROADCAST_EXCHANGE  |PARTITIONED|
                                                    limit 1
                                                    -- STREAM_LIMIT  |UNPARTITIONED|
                                                      project ([$$148])
                                                      -- STREAM_PROJECT  |PARTITIONED|
                                                        exchange
                                                        -- SORT_MERGE_EXCHANGE [$$152(ASC) ]  |PARTITIONED|
                                                          limit 1
                                                          -- STREAM_LIMIT  |PARTITIONED|
                                                            exchange
