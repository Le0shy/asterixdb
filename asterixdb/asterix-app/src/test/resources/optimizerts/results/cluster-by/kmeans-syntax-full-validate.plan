distribute result [$$89]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    assign [$$89] <- [{"cid": $#1, "cnt": sql-count($$movieCluster), "movieCluster": $$movieCluster}] project: [$$89]
    -- ASSIGN  |PARTITIONED|
      exchange
      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
        group by ([$#1 := $$107]) decor ([]) {
                  aggregate [$$movieCluster] <- [listify($$86)] [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                  -- AGGREGATE  |LOCAL|
                    nested tuple source [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                    -- NESTED_TUPLE_SOURCE  |LOCAL|
               }
        -- PRE_CLUSTERED_GROUP_BY[$$107]  |PARTITIONED|
          exchange
          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
            order (ASC, $$107)
            -- STABLE_SORT [$$107(ASC)]  |PARTITIONED|
              exchange
              -- HASH_PARTITION_EXCHANGE [$$107]  |PARTITIONED|
                project ([$$86, $$107])
                -- STREAM_PROJECT  |PARTITIONED|
                  exchange
                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                    kmeans-stage $$107 <- lloyd-loop $$90 vs pool $$105 by euclidean_squared
                    -- KMEANS_LLOYD_LOOP  |PARTITIONED|
                      exchange
                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                        assign [$$90, $$86] <- [$$99, $$100] project: [$$90, $$86]
                        -- ASSIGN  |PARTITIONED|
                          exchange
                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                            replicate
                            -- REPLICATE  |PARTITIONED|
                              exchange
                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                assign [$$99, $$100] <- [$$93, $$94] project: [$$99, $$100]
                                -- ASSIGN  |PARTITIONED|
                                  exchange
                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                    replicate
                                    -- REPLICATE  |PARTITIONED|
                                      exchange
                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                        assign [$$94] <- [{"m": $$95}] project: [$$93, $$94]
                                        -- ASSIGN  |PARTITIONED|
                                          select (and(lt($$95.getField(1), 2020), eq(len($$93), 2), is-array($$93)))
                                          -- STREAM_SELECT  |PARTITIONED|
                                            assign [$$93] <- [$$95.getField(2)]
                                            -- ASSIGN  |PARTITIONED|
                                              project ([$$95])
                                              -- STREAM_PROJECT  |PARTITIONED|
                                                exchange
                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                  data-scan []<-[$$97, $$95] <- clusterby_test.movies
                                                  -- DATASOURCE_SCAN  |PARTITIONED|
                                                    exchange
                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                      empty-tuple-source
                                                      -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                      exchange
                      -- BROADCAST_EXCHANGE  |PARTITIONED|
                        kmeans-stage $$105 <- recluster pool $$104 to 5 means by euclidean_squared
                        -- KMEANS_RECLUSTER  |PARTITIONED|
                          exchange
                          -- BROADCAST_EXCHANGE  |PARTITIONED|
                            kmeans-stage $$104 <- oversample-loop 5 rounds of $$99 vs seed $$93 by euclidean_squared
                            -- KMEANS_OVERSAMPLE_LOOP  |PARTITIONED|
                              exchange
                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                replicate
                                -- REPLICATE  |PARTITIONED|
                                  exchange
                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                    assign [$$99, $$100] <- [$$93, $$94] project: [$$99, $$100]
                                    -- ASSIGN  |PARTITIONED|
                                      exchange
                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                        replicate
                                        -- REPLICATE  |PARTITIONED|
                                          exchange
                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                            assign [$$94] <- [{"m": $$95}] project: [$$93, $$94]
                                            -- ASSIGN  |PARTITIONED|
                                              select (and(lt($$95.getField(1), 2020), eq(len($$93), 2), is-array($$93)))
                                              -- STREAM_SELECT  |PARTITIONED|
                                                assign [$$93] <- [$$95.getField(2)]
                                                -- ASSIGN  |PARTITIONED|
                                                  project ([$$95])
                                                  -- STREAM_PROJECT  |PARTITIONED|
                                                    exchange
                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                      data-scan []<-[$$97, $$95] <- clusterby_test.movies
                                                      -- DATASOURCE_SCAN  |PARTITIONED|
                                                        exchange
                                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                          empty-tuple-source
                                                          -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                              exchange
                              -- BROADCAST_EXCHANGE  |PARTITIONED|
                                limit 1
                                -- STREAM_LIMIT  |UNPARTITIONED|
                                  project ([$$93])
                                  -- STREAM_PROJECT  |PARTITIONED|
                                    exchange
                                    -- SORT_MERGE_EXCHANGE [$$98(ASC) ]  |PARTITIONED|
                                      limit 1
                                      -- STREAM_LIMIT  |PARTITIONED|
                                        exchange
                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                          order (ASC, $$98)
                                          -- STABLE_SORT [$$98(ASC)]  |PARTITIONED|
                                            exchange
                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                              assign [$$98] <- [random(get-item($$93, 0))]
                                              -- ASSIGN  |PARTITIONED|
                                                project ([$$93])
                                                -- STREAM_PROJECT  |PARTITIONED|
                                                  exchange
                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                    replicate
                                                    -- REPLICATE  |PARTITIONED|
                                                      exchange
                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                        assign [$$94] <- [{"m": $$95}] project: [$$93, $$94]
                                                        -- ASSIGN  |PARTITIONED|
                                                          select (and(lt($$95.getField(1), 2020), eq(len($$93), 2), is-array($$93)))
                                                          -- STREAM_SELECT  |PARTITIONED|
                                                            assign [$$93] <- [$$95.getField(2)]
                                                            -- ASSIGN  |PARTITIONED|
                                                              project ([$$95])
                                                              -- STREAM_PROJECT  |PARTITIONED|
                                                                exchange
                                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                  data-scan []<-[$$97, $$95] <- clusterby_test.movies
                                                                  -- DATASOURCE_SCAN  |PARTITIONED|
                                                                    exchange
                                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                      empty-tuple-source
                                                                      -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
