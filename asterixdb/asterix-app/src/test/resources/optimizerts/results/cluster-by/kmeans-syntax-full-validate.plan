                                                      select (lt($#1.getField(1), 2020)) project: [$$214]
                                                      -- STREAM_SELECT  |PARTITIONED|
                                                        assign [$$214] <- [$#1.getField(2)]
                                                        -- ASSIGN  |PARTITIONED|
                                                          project ([$#1])
                                                          -- STREAM_PROJECT  |PARTITIONED|
                                                            exchange
                                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                              data-scan []<-[$$242, $#1] <- clusterby_test.movies
                                                              -- DATASOURCE_SCAN  |PARTITIONED|
                                                                exchange
                                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                  empty-tuple-source
                                                                  -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                            exchange
