                                                                      order (topK: 1) (ASC, $$201)
                                                                      -- STABLE_SORT [topK: 1] [$$201(ASC)]  |PARTITIONED|
                                                                        exchange
                                                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                          assign [$$201] <- [random(get-item($$199, 0))]
                                                                          -- ASSIGN  |PARTITIONED|
                                                                            exchange
