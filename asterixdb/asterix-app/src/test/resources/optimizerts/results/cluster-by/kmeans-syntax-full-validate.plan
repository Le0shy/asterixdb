distribute result [$$214]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    assign [$$214] <- [{"cid": $#5, "cnt": $$224, "movieCluster": $$211}] project: [$$214]
    -- ASSIGN  |PARTITIONED|
      exchange
      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
        group by ([$#5 := $$229]) decor ([]) {
                  aggregate [$$211, $$224] <- [listify($$208), agg-sql-count($$208)] [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                  -- AGGREGATE  |LOCAL|
                    nested tuple source [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                    -- NESTED_TUPLE_SOURCE  |LOCAL|
               }
        -- PRE_CLUSTERED_GROUP_BY[$$229]  |PARTITIONED|
          exchange
          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
            order (ASC, $$229)
            -- STABLE_SORT [$$229(ASC)]  |PARTITIONED|
              exchange
              -- HASH_PARTITION_EXCHANGE [$$229]  |PARTITIONED|
                assign [$$208] <- [{"m": $$m}] project: [$$208, $$229]
                -- ASSIGN  |PARTITIONED|
                  select (and(is-array($$218), eq(len($$218), 2), not(is-unknown($$229)), lt($$m.getField(1), 2020))) project: [$$m, $$229]
                  -- STREAM_SELECT  |PARTITIONED|
                    assign [$$229] <- [nearest-centroid($$218, $$194)] project: [$$m, $$218, $$229]
                    -- ASSIGN  |PARTITIONED|
                      assign [$$218] <- [$$m.getField(2)]
                      -- ASSIGN  |PARTITIONED|
                        project ([$$194, $$m])
                        -- STREAM_PROJECT  |PARTITIONED|
                          exchange
                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                            data-scan []<-[$$222, $$m] <- clusterby_test.movies
                            -- DATASOURCE_SCAN  |PARTITIONED|
                              exchange
                              -- BROADCAST_EXCHANGE  |PARTITIONED|
                                aggregate [$$194] <- [listify($$190)]
                                -- AGGREGATE  |UNPARTITIONED|
                                  exchange
                                  -- SORT_MERGE_EXCHANGE [$$190(ASC) ]  |PARTITIONED|
                                    order (ASC, $$190)
                                    -- STABLE_SORT [$$190(ASC)]  |PARTITIONED|
                                      exchange
                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                        kmeans-stage $$190 <- lloyd-loop $$216 vs pool $$188 by euclidean_squared
                                        -- KMEANS_LLOYD_LOOP  |PARTITIONED|
                                          exchange
                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                            assign [$$216] <- [$$217] project: [$$216]
                                            -- ASSIGN  |PARTITIONED|
                                              exchange
                                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                replicate
                                                -- REPLICATE  |PARTITIONED|
                                                  exchange
                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                    assign [$$217] <- [$$223] project: [$$217]
                                                    -- ASSIGN  |PARTITIONED|
                                                      exchange
                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                        replicate
                                                        -- REPLICATE  |PARTITIONED|
                                                          exchange
                                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                            select (and(lt($$m.getField(1), 2020), eq(len($$223), 2), is-array($$223))) project: [$$223]
                                                            -- STREAM_SELECT  |PARTITIONED|
                                                              assign [$$223] <- [$$m.getField(2)]
                                                              -- ASSIGN  |PARTITIONED|
                                                                project ([$$m])
                                                                -- STREAM_PROJECT  |PARTITIONED|
                                                                  exchange
                                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                    data-scan []<-[$$221, $$m] <- clusterby_test.movies
                                                                    -- DATASOURCE_SCAN  |PARTITIONED|
                                                                      exchange
                                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                        empty-tuple-source
                                                                        -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                          exchange
                                          -- BROADCAST_EXCHANGE  |PARTITIONED|
                                            kmeans-stage $$188 <- recluster pool $$186 to 5 means by euclidean_squared
                                            -- KMEANS_RECLUSTER  |PARTITIONED|
                                              exchange
                                              -- BROADCAST_EXCHANGE  |PARTITIONED|
                                                kmeans-stage $$186 <- oversample-loop 5 rounds of $$217 vs seed $$223 by euclidean_squared
                                                -- KMEANS_OVERSAMPLE_LOOP  |PARTITIONED|
                                                  exchange
                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                    replicate
                                                    -- REPLICATE  |PARTITIONED|
                                                      exchange
                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                        assign [$$217] <- [$$223] project: [$$217]
                                                        -- ASSIGN  |PARTITIONED|
                                                          exchange
                                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                            replicate
                                                            -- REPLICATE  |PARTITIONED|
                                                              exchange
                                                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                select (and(lt($$m.getField(1), 2020), eq(len($$223), 2), is-array($$223))) project: [$$223]
                                                                -- STREAM_SELECT  |PARTITIONED|
                                                                  assign [$$223] <- [$$m.getField(2)]
                                                                  -- ASSIGN  |PARTITIONED|
                                                                    project ([$$m])
                                                                    -- STREAM_PROJECT  |PARTITIONED|
                                                                      exchange
                                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                        data-scan []<-[$$221, $$m] <- clusterby_test.movies
                                                                        -- DATASOURCE_SCAN  |PARTITIONED|
                                                                          exchange
                                                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                            empty-tuple-source
                                                                            -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                                  exchange
                                                  -- BROADCAST_EXCHANGE  |PARTITIONED|
                                                    limit 1
                                                    -- STREAM_LIMIT  |UNPARTITIONED|
                                                      project ([$$223])
                                                      -- STREAM_PROJECT  |PARTITIONED|
                                                        exchange
                                                        -- SORT_MERGE_EXCHANGE [$$183(ASC) ]  |PARTITIONED|
                                                          limit 1
                                                          -- STREAM_LIMIT  |PARTITIONED|
                                                            exchange
                                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                              order (topK: 1) (ASC, $$183)
                                                              -- STABLE_SORT [topK: 1] [$$183(ASC)]  |PARTITIONED|
                                                                exchange
                                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                  assign [$$183] <- [random(get-item($$223, 0))]
                                                                  -- ASSIGN  |PARTITIONED|
                                                                    exchange
                                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                      replicate
                                                                      -- REPLICATE  |PARTITIONED|
                                                                        exchange
                                                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                          select (and(lt($$m.getField(1), 2020), eq(len($$223), 2), is-array($$223))) project: [$$223]
                                                                          -- STREAM_SELECT  |PARTITIONED|
                                                                            assign [$$223] <- [$$m.getField(2)]
                                                                            -- ASSIGN  |PARTITIONED|
                                                                              project ([$$m])
                                                                              -- STREAM_PROJECT  |PARTITIONED|
                                                                                exchange
                                                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                                  data-scan []<-[$$221, $$m] <- clusterby_test.movies
