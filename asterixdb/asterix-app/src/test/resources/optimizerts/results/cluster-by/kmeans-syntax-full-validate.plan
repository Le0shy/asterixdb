distribute result [$$83]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    assign [$$83] <- [{"cid": $#1, "cnt": sql-count($$movieCluster), "movieCluster": $$movieCluster}] project: [$$83]
    -- ASSIGN  |PARTITIONED|
      exchange
      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
        group by ([$#1 := $$94]) decor ([]) {
                  aggregate [$$movieCluster] <- [listify($$80)] [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                  -- AGGREGATE  |LOCAL|
                    nested tuple source [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                    -- NESTED_TUPLE_SOURCE  |LOCAL|
               }
        -- PRE_CLUSTERED_GROUP_BY[$$94]  |PARTITIONED|
          exchange
          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
            order (ASC, $$94)
            -- STABLE_SORT [$$94(ASC)]  |PARTITIONED|
              exchange
              -- HASH_PARTITION_EXCHANGE [$$94]  |PARTITIONED|
                select (not(is-unknown($$94)))
                -- STREAM_SELECT  |PARTITIONED|
                  assign [$$94] <- [nearest-centroid($$79, $$93, "euclidean_squared", "m.reviewEmbedding")] project: [$$79, $$80, $$94]
                  -- ASSIGN  |PARTITIONED|
                    exchange
                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                      join (true)
                      -- NESTED_LOOP  |PARTITIONED|
                        exchange
                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                          replicate
                          -- REPLICATE  |PARTITIONED|
                            exchange
                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                              assign [$$80] <- [{"m": $$m}] project: [$$79, $$80]
                              -- ASSIGN  |PARTITIONED|
                                select (lt($$m.getField(1), 2020))
                                -- STREAM_SELECT  |PARTITIONED|
                                  assign [$$79] <- [$$m.getField(2)]
                                  -- ASSIGN  |PARTITIONED|
                                    project ([$$m])
                                    -- STREAM_PROJECT  |PARTITIONED|
                                      exchange
                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                        data-scan []<-[$$84, $$m] <- clusterby_test.movies
                                        -- DATASOURCE_SCAN  |PARTITIONED|
                                          exchange
                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                            empty-tuple-source
                                            -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                        exchange
                        -- BROADCAST_EXCHANGE  |PARTITIONED|
                          aggregate [$$93] <- [listify($$92)]
                          -- AGGREGATE  |UNPARTITIONED|
                            exchange
                            -- SORT_MERGE_EXCHANGE [$$92(ASC) ]  |PARTITIONED|
                              order (ASC, $$92)
                              -- STABLE_SORT [$$92(ASC)]  |PARTITIONED|
                                exchange
                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                  kmeans-stage $$92 <- lloyd-loop $$91 vs pool $$90 by euclidean_squared
                                  -- KMEANS_LLOYD_LOOP  |PARTITIONED|
                                    exchange
                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                      assign [$$91] <- [$$79]
                                      -- ASSIGN  |PARTITIONED|
                                        exchange
                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                          replicate
                                          -- REPLICATE  |PARTITIONED|
                                            exchange
                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                              assign [$$80] <- [{"m": $$m}] project: [$$79, $$80]
                                              -- ASSIGN  |PARTITIONED|
                                                select (lt($$m.getField(1), 2020))
                                                -- STREAM_SELECT  |PARTITIONED|
                                                  assign [$$79] <- [$$m.getField(2)]
                                                  -- ASSIGN  |PARTITIONED|
                                                    project ([$$m])
                                                    -- STREAM_PROJECT  |PARTITIONED|
                                                      exchange
                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                        data-scan []<-[$$84, $$m] <- clusterby_test.movies
                                                        -- DATASOURCE_SCAN  |PARTITIONED|
                                                          exchange
                                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                            empty-tuple-source
                                                            -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                    exchange
                                    -- BROADCAST_EXCHANGE  |PARTITIONED|
                                      kmeans-stage $$90 <- recluster pool $$89 to 5 means by euclidean_squared
                                      -- KMEANS_RECLUSTER  |PARTITIONED|
                                        exchange
                                        -- BROADCAST_EXCHANGE  |PARTITIONED|
                                          kmeans-stage $$89 <- oversample-loop 5 rounds of $$88 vs seed $$86 by euclidean_squared
                                          -- KMEANS_OVERSAMPLE_LOOP  |PARTITIONED|
                                            exchange
                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                              assign [$$88] <- [$$79]
                                              -- ASSIGN  |PARTITIONED|
                                                exchange
                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                  replicate
                                                  -- REPLICATE  |PARTITIONED|
                                                    exchange
                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                      assign [$$80] <- [{"m": $$m}] project: [$$79, $$80]
                                                      -- ASSIGN  |PARTITIONED|
                                                        select (lt($$m.getField(1), 2020))
                                                        -- STREAM_SELECT  |PARTITIONED|
                                                          assign [$$79] <- [$$m.getField(2)]
                                                          -- ASSIGN  |PARTITIONED|
                                                            project ([$$m])
                                                            -- STREAM_PROJECT  |PARTITIONED|
                                                              exchange
                                                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                data-scan []<-[$$84, $$m] <- clusterby_test.movies
                                                                -- DATASOURCE_SCAN  |PARTITIONED|
                                                                  exchange
                                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                    empty-tuple-source
                                                                    -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                            exchange
                                            -- BROADCAST_EXCHANGE  |PARTITIONED|
                                              limit 1
                                              -- STREAM_LIMIT  |UNPARTITIONED|
                                                project ([$$79, $$80, $$86])
                                                -- STREAM_PROJECT  |PARTITIONED|
                                                  exchange
                                                  -- SORT_MERGE_EXCHANGE [$$87(ASC) ]  |PARTITIONED|
                                                    limit 1
                                                    -- STREAM_LIMIT  |PARTITIONED|
                                                      exchange
                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                        order (ASC, $$87)
                                                        -- STABLE_SORT [$$87(ASC)]  |PARTITIONED|
                                                          exchange
                                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                            assign [$$87] <- [random(get-item($$86, 0))]
                                                            -- ASSIGN  |PARTITIONED|
                                                              select (and(is-array($$86), eq(sql-count($$86), 2)))
                                                              -- STREAM_SELECT  |PARTITIONED|
                                                                assign [$$86] <- [$$79]
                                                                -- ASSIGN  |PARTITIONED|
                                                                  exchange
                                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                    replicate
                                                                    -- REPLICATE  |PARTITIONED|
                                                                      exchange
                                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                        assign [$$80] <- [{"m": $$m}] project: [$$79, $$80]
                                                                        -- ASSIGN  |PARTITIONED|
                                                                          select (lt($$m.getField(1), 2020))
                                                                          -- STREAM_SELECT  |PARTITIONED|
                                                                            assign [$$79] <- [$$m.getField(2)]
                                                                            -- ASSIGN  |PARTITIONED|
                                                                              project ([$$m])
                                                                              -- STREAM_PROJECT  |PARTITIONED|
                                                                                exchange
                                                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                                  data-scan []<-[$$84, $$m] <- clusterby_test.movies
                                                                                  -- DATASOURCE_SCAN  |PARTITIONED|
                                                                                    exchange
