-- CLUSTER BY runtime-init plan validation: with the cluster_by_runtime_init flag, round 1 of the
-- k-means|| oversampling loop compiles to the dedicated KMEANS_INIT_CANDIDATES operator (two stream
-- inputs, broadcast pool) instead of the sort-based desugar; the rest of the shape matches kmeans-syntax-validate.
drop dataverse clusterby_test if exists;
create dataverse clusterby_test;
use clusterby_test;

create type clusterby_test.ReviewType as closed {
  id : integer,
  reviewEmbedding : [double]
};
create dataset Reviews(ReviewType) primary key id;

set `cluster_by_runtime_init` "true";

from Reviews as r
cluster by r.reviewEmbedding as sc
with { "NumClusters": 2 }
select sc.cluster_id as cid, sc.centroid as centroid;
