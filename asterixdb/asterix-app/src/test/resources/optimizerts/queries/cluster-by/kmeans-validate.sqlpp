-- Desugared-plan validation: distributed k-means expressed as plain SQL++ so the optimizer builds the
-- broadcast + two-step CENTROID aggregate (rather than us hand-wiring a Replicate). Minimal form:
-- one seed cluster (GROUP BY 0) -> centroids computed by the two-step CENTROID aggregate -> the
-- (uncorrelated) centroids subquery is broadcast to every point via nearest_centroid.
drop dataverse clusterby_test if exists;
create dataverse clusterby_test;
use clusterby_test;

create type clusterby_test.ReviewType as closed {
  id : integer,
  reviewEmbedding : [double]
};
create dataset Reviews(ReviewType) primary key id;

select r.id as id,
       nearest_centroid(r.reviewEmbedding,
           (select value centroid(r2.reviewEmbedding) from Reviews r2 group by 0)) as cluster_id
from Reviews r;
