-- Full desugared-plan validation: distributed k-means, k=8, seed + 3 unrolled Lloyd iterations, all in SQL++.
-- Each C_i is an uncorrelated centroid subquery (two-step CENTROID aggregate) broadcast to the next step.
-- This is the template the CLUSTER BY rewrite must produce.
drop dataverse clusterby_test if exists;
create dataverse clusterby_test;
use clusterby_test;

create type clusterby_test.ReviewType as closed {
  id : integer,
  reviewEmbedding : [double]
};
create dataset Reviews(ReviewType) primary key id;

select r.id as id, nearest_centroid(r.reviewEmbedding, C3) as cluster_id
from Reviews r
let C0 = (select value centroid(s.reviewEmbedding) from Reviews s group by (s.id % 8)),
    C1 = (select value centroid(s.reviewEmbedding) from Reviews s
          group by nearest_centroid(s.reviewEmbedding, C0)),
    C2 = (select value centroid(s.reviewEmbedding) from Reviews s
          group by nearest_centroid(s.reviewEmbedding, C1)),
    C3 = (select value centroid(s.reviewEmbedding) from Reviews s
          group by nearest_centroid(s.reviewEmbedding, C2));
